// use prisma-8

model User {
  id        String       @id @default(cuid(2))
  username  String       @unique
  email     String       @unique
  name      String
  password  String
  world     String
  path      String
  goal      String
  why       String
  stats     UserStats?
  sessions  Session[]
  streak    UserStreak?
  xp        UserXP?
  skills    UserSkill[]   
  createdAt DateTime     @default(now())
  updatedAt temporal.updatedAt()

  @@map("users")
}

model Session {
  id          String   @id @default(cuid(2))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String?
  deviceName  String?
  browser     String?
  os          String?
  city        String?
  country     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("sessions")
}

model UserXP {
  id           String    @id @default(cuid(2))
  userId       String    @unique
  totalXp      Int       @default(0)
  skillXp      Int       @default(0)
  streakXp     Int       @default(0)
  streakDays   Int       @default(0)
  lastTrainedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp])
  @@map("user_xp")
}

model UserStreak {
  id               String    @id @default(cuid(2))
  userId           String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastCheckInDate  String?
  lastCheckInAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        temporal.updatedAt()
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak])
  @@map("user_streaks")
}

model UserSkill {
  id         String    @id @default(cuid(2))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillSlug  String
  bestSet    Int       @default(0)
  masteredAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([userId, skillSlug])
  @@index([userId])
  @@index([skillSlug])
  @@index([masteredAt])
  @@map("user_skills")
}