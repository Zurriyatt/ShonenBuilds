// use prisma-8

model User {
  // FIX: Explicitly use cuid(2) in Prisma 8
  id        String   @id @default(cuid(2)) 
  username  String   @unique
  email     String   @unique
  name      String
  password  String
  world     String
  path      String
  goal      String
  why       String
  stats     UserStats?
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@map("users")
}

model UserStats {
  // FIX: Explicitly use cuid(2) in Prisma 8
  id            String   @id @default(cuid(2)) 
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp            Int      @default(0)
  level         Int      @default(1) 
  tier          Int      @default(0) 
  powerLevel    Int      @default(10)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  totalWorkouts Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

  @@map("user_stats")
}

model Session {
  // FIX: Explicitly use cuid(2) in Prisma 8
  id          String   @id @default(cuid(2)) 
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String?
  deviceName  String?
  browser     String?
  os          String?
  city        String?
  country     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()
  
  @@map("sessions")
}
