# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string replace cache
.grunt

# Bower dependency directory (if used)
bower_components

# node-modules (The most critical one to ignore)
node_modules/
jspm_packages/

# Snowpack dependency directory
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.microbundle

# ShellCheck cache
.shellcheckrc

# Output directory of TypeScript compiler / build outputs
dist/
build/
out/

# Next.js build output
.next/
out/

# Nuxt.js build project
.nuxt

# Gatsby files
.cache/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files (Crucial for security)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-cache
.parcel-cache

# OS generated files (Mac / Windows)
.DS_Store
Thumbs.db
